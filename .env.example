# ─────────────────────────────────────────────────────────────────────────
#  Copy to .env (backend) and .env.local (frontend). Never commit either.
# ─────────────────────────────────────────────────────────────────────────

# ── Frontend (.env.local) ───────────────────────────────────────────────
# Where the API lives. In production the frontend and API share a domain,
# so this is the app's own URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Analytics (.env.local) ──────────────────────────────────────────────
# PostHog project API key ("phc_..."). Leave EMPTY to disable analytics
# entirely: with no key the client is a no-op, so nothing is collected and
# nothing is sent. This is the correct setting for local development.
NEXT_PUBLIC_POSTHOG_KEY=

# Ingestion and dashboard hosts. Use the eu.* pair for an EU project.
#   US: https://us.i.posthog.com  /  https://us.posthog.com
#   EU: https://eu.i.posthog.com  /  https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Session REPLAY — records the screen, not just events. Off by default and it
# should stay off unless you have decided you want it: this app displays client
# spend and revenue, and replay ships what is on screen to PostHog. Event-level
# session tracking (counts, duration, entry/exit screens) works either way and
# needs no replay. When enabled, all text and inputs are masked.
NEXT_PUBLIC_POSTHOG_SESSION_REPLAY=false


# ── Backend (.env) ──────────────────────────────────────────────────────

# Postgres. The local default matches docker-compose.yml (host port 5433).
# Managed providers' postgres:// and postgresql:// URLs are both accepted.
DATABASE_URL=postgresql+psycopg://adlytix:adlytix_dev@localhost:5433/adlytix

# Signs session tokens. REQUIRED when ENVIRONMENT=production — the service
# refuses to start without it rather than signing with a guessable value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# development | production. Controls cookie defaults and whether a missing
# JWT_SECRET is fatal.
ENVIRONMENT=development

# Browser origins allowed to call the API. Must be explicit — the session is a
# credentialed cookie, and browsers reject credentials against a wildcard.
CORS_ORIGINS=http://localhost:3000

# Cookie policy. Leave unset to use the right default for ENVIRONMENT:
#   production  -> SameSite=Lax, Secure  (frontend and API share a domain)
#   development -> SameSite=None, Secure (they are different origins;
#                                         localhost counts as secure)
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# Session lifetimes.
SESSION_HOURS=12
REMEMBER_DAYS=30

# First administrator, created on startup only when no admin exists yet.
# Safe to leave set after the first boot — seeding never runs twice.
# The email must be a real domain: reserved TLDs (.local, .test, .example)
# are rejected by sign-in, so seeding with one is refused.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ── AI insights (.env, backend) ─────────────────────────────────────────
# Google AI Studio API key for Gemini. Leave EMPTY to disable the feature:
# the endpoint then returns 503 and the screen says it is not configured. It
# NEVER falls back to canned advice — invented recommendations about a real ad
# budget are worse than none.
#
# This key must stay server-side. It is deliberately not a NEXT_PUBLIC_ var:
# the frontend is a static export, so anything prefixed that way is inlined
# into the bundle and readable by anyone.
#
# What is sent to Google when an operator clicks Generate: per-quadrant
# totals plus up to 8 product IDs, titles and figures per quadrant. That is
# client business data leaving your infrastructure — the feature cannot work
# without it, but you should know it happens.
GOOGLE_API_KEY=

# Override the model if you want a different tier.
# GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to log every SQL statement.
# SQL_ECHO=0
